---
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import { getTranslation } from "../i18n/index";

interface Props {
  lang?: string;
}

const { lang = "sk" } = Astro.props;

const t = (key: string) => getTranslation(lang, key);
---

<section class="relative min-h-screen flex items-center pt-2 sm:pt-4 lg:pt-20 overflow-hidden">
  <!-- Background gradient effects -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="hidden sm:block absolute top-1/4 -left-20 w-96 h-96 bg-gradient-to-br from-yellow-400/20 to-transparent rounded-full blur-3xl animate-float"></div>
    <div class="hidden sm:block absolute bottom-1/4 -right-20 w-96 h-96 bg-gradient-to-tl from-cyan-400/20 to-transparent rounded-full blur-3xl animate-float" style="animation-delay: -3s;"></div>
  </div>

  <Container>
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center relative z-10">
      <!-- Left Content -->
      <div class="space-y-6 lg:space-y-8 animate-fade-up">
        <!-- Availability Badge -->
        <div class="inline-flex items-center gap-2 rounded-full glass px-2 py-1 sm:px-3 sm:py-1.5 w-fit hover-lift hero-badge">
          <div class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-lime-400 animate-pulse-glow"></div>
          <span class="text-xs sm:text-sm font-medium">{t('hero.available')}</span>
        </div>

        <!-- Name -->
        <div class="space-y-1 sm:space-y-2">
          <h1 class="heading-font text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-bold leading-tight">
            <span class="gradient-text">{t('hero.title')}</span>
          </h1>
          <p class="text-xs sm:text-sm md:text-base lg:text-lg text-neutral-400 font-light">
            {t('hero.subtitle')}
          </p>
        </div>

        <!-- Description -->
        <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed max-w-xs sm:max-w-sm">
          {t('hero.description')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-row gap-2 sm:gap-3 pt-2 sm:pt-3">
          <Button href={lang === "en" ? "/en#contact" : "/#contact"} variant="primary" class="glow-accent text-xs sm:text-sm px-3 py-2 sm:px-4 sm:py-2">
            {t('hero.cta1')}
          </Button>
          <Button href={lang === "en" ? "/en#work" : "/#work"} variant="secondary" class="text-xs sm:text-sm px-3 py-2 sm:px-4 sm:py-2">
            {t('hero.cta2')}
          </Button>
        </div>
      </div>

      <!-- Right - Profile Image -->
      <div class="relative h-40 sm:h-48 md:h-64 lg:h-full min-h-40 sm:min-h-48 md:min-h-64 animate-scale-in" style="animation-delay: 0.3s;">
        <!-- Main profile container with gradient border -->
        <div class="absolute inset-0 rounded-3xl overflow-hidden hover-lift transition-all duration-300">
          <!-- Gradient border effect -->
          <div class="absolute inset-0 bg-linear-to-br from-yellow-400/30 via-transparent to-cyan-400/30 rounded-3xl opacity-0 hover:opacity-100 transition-opacity duration-300"></div>

          <!-- Profile image with overlay -->
          <div class="absolute inset-0 rounded-3xl overflow-hidden glass">
            <img
              src="/images/projects/profile.jpg"
              alt="Simon Mészáros"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <!-- Subtle dark overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
          </div>
        </div>

        <!-- Decorative blur circles -->
        <div class="hidden sm:block absolute -top-20 -right-20 w-64 h-64 bg-lime-400/10 rounded-full blur-3xl animate-float"></div>
        <div class="hidden sm:block absolute -bottom-20 -left-20 w-64 h-64 bg-cyan-400/10 rounded-full blur-3xl animate-float" style="animation-delay: -2s;"></div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <a href={lang === "en" ? "/en#work" : "/#work"} class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 animate-bounce inline-flex items-center justify-center rounded-full border border-white/10 bg-black/40 p-2 sm:p-3 transition hover:bg-white/10 hover-lift">
      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </a>
  </Container>
</section>