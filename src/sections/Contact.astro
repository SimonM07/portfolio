---
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
import { getTranslation } from "../i18n/index";

interface Props {
  lang?: string;
}

const { lang = "sk" } = Astro.props;

const t = (key: string) => getTranslation(lang, key);
---

<section id="contact" class="py-12 sm:py-16 lg:py-32 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-gradient-to-r from-yellow-400/10 to-cyan-400/10 rounded-full blur-3xl"></div>

  <Container>
    <div class="scroll-reveal">
      <SectionTitle subtitle={t('contact.subtitle')} title={t('contact.title')} />
    </div>

    <div class="mx-auto max-w-2xl mt-8 sm:mt-12 lg:mt-16">
      <div class="rounded-2xl glass gradient-border p-4 sm:p-6 lg:p-12 scroll-reveal">
        <form
          action="https://formspree.io/f/xljrngor"
          method="POST"
          class="space-y-3 sm:space-y-4 lg:space-y-6"
          id="contact-form"
        >
          <!-- Hidden fields for Formspree -->
          <input type="hidden" name="_subject" value="New Contact Form Submission from Portfolio" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="" />
          <div>
            <label for="name" class="block text-xs sm:text-sm font-semibold mb-1 sm:mb-2">
              {t('contact.name')}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-3 py-2 sm:px-4 sm:py-3 text-white placeholder-neutral-500 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/20 text-sm sm:text-base"
              placeholder={t('contact.namePlaceholder')}
            />
          </div>

          <div>
            <label for="email" class="block text-xs sm:text-sm font-semibold mb-1 sm:mb-2">
              {t('contact.email')}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-3 py-2 sm:px-4 sm:py-3 text-white placeholder-neutral-500 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/20 text-sm sm:text-base"
              placeholder={t('contact.emailPlaceholder')}
            />
          </div>

          <div>
            <label for="message" class="block text-xs sm:text-sm font-semibold mb-1 sm:mb-2">
              {t('contact.message')}
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={4}
              class="w-full rounded-lg border border-neutral-700 bg-neutral-950/80 px-3 py-2 sm:px-4 sm:py-3 text-white placeholder-neutral-500 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/20 resize-none text-sm sm:text-base"
              placeholder={t('contact.messagePlaceholder')}
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-white px-4 py-2 sm:px-6 sm:py-3 font-semibold text-black transition hover:bg-neutral-200 hover-lift glow-accent text-sm sm:text-base"
            id="submit-btn"
          >
            {t('contact.send')}
          </button>

          <!-- Success/Error Messages -->
          <div id="form-message" class="hidden"></div>
        </form>

        <div class="mt-6 sm:mt-8 lg:mt-12 border-t border-neutral-800 pt-6 sm:pt-8 lg:pt-12">
          <h3 class="heading-font mb-4 sm:mb-6 lg:mb-8 text-lg sm:text-xl lg:text-2xl font-bold">{t('contact.connect')}</h3>
          <div class="grid gap-3 sm:gap-4 sm:grid-cols-2">
            <a
              href="tel:+421915382092"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3 sm:px-6 sm:py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-xs sm:text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">Phone</p>
              <p class="text-sm sm:font-semibold group-hover:text-white">+421 915 382 092</p>
            </a>
            <a
              href="mailto:simon07meszaros@gmail.com"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3 sm:px-6 sm:py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-xs sm:text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">{t('contact.emailLabel')}</p>
              <p class="text-sm sm:font-semibold group-hover:text-white">simon07meszaros@gmail.com</p>
            </a>
            <a
              href="https://instagram.com/simonvideography"
              target="_blank"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3 sm:px-6 sm:py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-xs sm:text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">{t('contact.instagramLabel')}</p>
              <p class="text-sm sm:font-semibold group-hover:text-white">@simonvideography</p>
            </a>
            <a
              href="https://linkedin.com/in/SimonMeszaros"
              target="_blank"
              class="rounded-lg border border-neutral-800 bg-neutral-900/50 px-4 py-3 sm:px-6 sm:py-4 transition hover:border-neutral-700 hover:bg-neutral-800 hover-lift group"
            >
              <p class="text-xs sm:text-sm text-neutral-500 mb-1 group-hover:text-neutral-400">{t('contact.linkedinLabel')}</p>
              <p class="text-sm sm:font-semibold group-hover:text-white">Simon Mészáros</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const formMessage = document.getElementById('form-message') as HTMLDivElement;

    if (!form || !submitBtn || !formMessage) return;

    const currentLang = document.documentElement.lang.startsWith('en') ? 'en' : 'sk';

    const messages = {
      en: {
        sending: 'Sending...',
        success: 'Thank you! Your message has been sent successfully.',
        error: 'Oops! There was a problem sending your message. Please try again.',
        networkError: 'Network error. Please check your connection and try again.',
        formNotFound: 'Form not found. Please contact me directly at simon07meszaros@gmail.com',
        send: 'Send Message'
      },
      sk: {
        sending: 'Odosielam...',
        success: 'Ďakujeme! Vaša správa bola úspešne odoslaná.',
        error: 'Ups! Pri odosielaní správy nastal problém. Skúste to znova.',
        networkError: 'Chyba siete. Skontrolujte pripojenie a skúste to znova.',
        formNotFound: 'Formulár nenájdený. Kontaktujte ma priamo na simon07meszaros@gmail.com',
        send: 'Odoslať správu'
      }
    };

    const currentMessages = messages[currentLang as keyof typeof messages] || messages.en;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Disable submit button and show loading state
      submitBtn.disabled = true;
      submitBtn.textContent = currentMessages.sending;
      
      const formData = new FormData(form);
      
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        // Handle Formspree response
        if (response.status === 404) {
          formMessage.classList.remove('hidden');
          formMessage.className = 'mt-4 p-4 rounded-lg bg-red-500/20 border border-red-500/50 text-red-400';
          formMessage.textContent = currentMessages.formNotFound;
          submitBtn.disabled = false;
          submitBtn.textContent = currentMessages.send;
          return;
        }

        const data = await response.json();

        if (response.ok) {
          // Success
          formMessage.classList.remove('hidden');
          formMessage.className = 'mt-4 p-4 rounded-lg bg-green-500/20 border border-green-500/50 text-green-400';
          formMessage.textContent = currentMessages.success;
          
          form.reset();
        } else {
          // Error
          formMessage.classList.remove('hidden');
          formMessage.className = 'mt-4 p-4 rounded-lg bg-red-500/20 border border-red-500/50 text-red-400';
          formMessage.textContent = data.error || currentMessages.error;
        }
      } catch (error) {
        // Network error
        formMessage.classList.remove('hidden');
        formMessage.className = 'mt-4 p-4 rounded-lg bg-red-500/20 border border-red-500/50 text-red-400';
        formMessage.textContent = currentMessages.networkError;
      } finally {
        // Re-enable submit button if not already done
        if (formMessage.textContent && !formMessage.textContent.includes(currentMessages.formNotFound)) {
          submitBtn.disabled = false;
          submitBtn.textContent = currentMessages.send;
        }
      }
    });
  });
</script>
