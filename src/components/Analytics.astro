---
// Google Analytics 4 - Simple tracking
// NOTE: Add your GA4 Measurement ID in the script below
---

<script>
  // Type declarations for GA4
  declare global {
    interface Window {
      dataLayer: any[];
      gtag: (...args: any[]) => void;
    }
  }

  // Replace with your GA4 Measurement ID
  const GA4_MEASUREMENT_ID = 'G-LJ1PLX3TWZ'; // Add your actual GA4 ID here

  // Initialize GA4
  if (typeof window !== 'undefined' && GA4_MEASUREMENT_ID) {
    // Load GA4 script
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`;
    document.head.appendChild(script);

    // Initialize gtag
    window.dataLayer = window.dataLayer || [];
    window.gtag = function() {
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', GA4_MEASUREMENT_ID);

    // Track page views
    window.gtag('event', 'page_view', {
      page_title: document.title,
      page_location: window.location.href
    });

    // Track navigation clicks
    document.addEventListener('click', (e) => {
      if (!e.target) return;
      const link = (e.target as HTMLElement).closest('a');
      if (link && (link as HTMLAnchorElement).href) {
        window.gtag('event', 'click', {
          event_category: 'navigation',
          event_label: (link as HTMLAnchorElement).href,
          value: 1
        });
      }
    });

    // Track button clicks
    document.addEventListener('click', (e) => {
      if (!e.target) return;
      const button = (e.target as HTMLElement).closest('button');
      if (button) {
        window.gtag('event', 'click', {
          event_category: 'interaction',
          event_label: button.textContent || 'button',
          value: 1
        });
      }
    });

    // Track form submissions
    document.addEventListener('submit', (e) => {
      const form = e.target as HTMLFormElement;
      if (form) {
        window.gtag('event', 'submit', {
          event_category: 'form',
          event_label: form.action || 'form submission',
          value: 1
        });
      }
    });
  } else {
    console.log('Analytics: Add your GA4 Measurement ID in src/components/Analytics.astro');
  }
</script>