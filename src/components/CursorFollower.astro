---
// Interactive cursor follower component
---

<div id="cursor-follower" class="fixed pointer-events-none z-50 hidden md:block">
  <div class="cursor-dot w-2 h-2 bg-white rounded-full"></div>
  <div class="cursor-ring w-8 h-8 border-2 border-white rounded-full opacity-50"></div>
</div>

<style>
  #cursor-follower {
    transition: transform 0.15s ease-out;
  }
  
  .cursor-dot {
    position: absolute;
    transform: translate(-50%, -50%);
    background: #ffffff;
  }
  
  .cursor-ring {
    position: absolute;
    transform: translate(-50%, -50%);
    transition: width 0.3s ease, height 0.3s ease, opacity 0.3s ease;
    border: 2px solid rgba(255, 255, 255, 0.5);
  }
  
  .cursor-ring.hover {
    width: 48px;
    height: 48px;
    opacity: 0.3;
    border-color: var(--accent);
  }
  
  html.light .cursor-dot {
    background: #0f172a;
  }
  
  html.light .cursor-ring {
    border-color: rgba(15, 23, 42, 0.65);
  }
</style>

<script>
  function initCursorFollower() {
    // Check for reduced motion preference or mobile device
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth < 1024; // md breakpoint
    
    if (prefersReducedMotion || isMobile) {
      const cursor = document.getElementById('cursor-follower');
      if (cursor) cursor.remove();
      return;
    }
    
    const cursor = document.getElementById('cursor-follower');
    if (!cursor) return;
    
    const dot = cursor.querySelector('.cursor-dot');
    const ring = cursor.querySelector('.cursor-ring');
    
    if (!dot || !ring) return;
    
    let mouseX = 0, mouseY = 0;
    let cursorX = 0, cursorY = 0;
    
    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });
    
    let animationId: number;
    let lastTime = 0;
    const targetFPS = 30;
    const frameInterval = 1000 / targetFPS;

    function animate(currentTime: number) {
      animationId = requestAnimationFrame(animate);

      const deltaTime = currentTime - lastTime;
      if (deltaTime < frameInterval) return;
      lastTime = currentTime - (deltaTime % frameInterval);

      cursorX += (mouseX - cursorX) * 0.4;
      cursorY += (mouseY - cursorY) * 0.4;

      if (cursor) {
        cursor.style.transform = `translate(${cursorX}px, ${cursorY}px)`;
      }
    }

    animate(0);

    // Cleanup when page is hidden to save memory
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(animationId);
      } else {
        animate(0);
      }
    });
    
    // Add hover effect on interactive elements
    const interactiveElements = document.querySelectorAll('a, button, .hover-lift');
    interactiveElements.forEach(el => {
      el.addEventListener('mouseenter', () => ring?.classList.add('hover'));
      el.addEventListener('mouseleave', () => ring?.classList.remove('hover'));
    });
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCursorFollower);
  } else {
    initCursorFollower();
  }
</script>
