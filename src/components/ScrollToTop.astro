---
// Scroll to top button component
---

<button
  id="scroll-to-top"
  class="fixed bottom-8 right-8 z-40 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-neutral-900 text-white border border-neutral-700 shadow-lg opacity-0 invisible transition-all duration-300 hover:bg-neutral-800 hover:border-neutral-600 hover:-translate-y-1 flex items-center justify-center"
  aria-label="Scroll to top"
>
  <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 15l-7-7-7 7"></path>
  </svg>
</button>

<style>
  #scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollBtn = document.getElementById('scroll-to-top');
    if (!scrollBtn) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 500) {
        scrollBtn.classList.add('visible');
      } else {
        scrollBtn.classList.remove('visible');
      }
    });

    scrollBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>
