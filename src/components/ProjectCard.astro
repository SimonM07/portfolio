---
interface Props {
  title: string
  category: string
  year: number
  image: string
  video?: string
  slug: string
  isNew?: boolean
}

const { title, category, year, image, video, slug, isNew = false } = Astro.props
---

<a href={`/projects/${slug}`} class="group block" data-project-slug={`/projects/${slug}`}>
    <article>

        <div class="overflow-hidden rounded-3xl relative aspect-video bg-black cursor-pointer transition-all duration-400 ease-out group-hover:shadow-2xl group-hover:shadow-yellow-400/20">

            {isNew && (
              <div class="absolute top-3 right-3 z-20 bg-yellow-400 text-black text-xs font-bold px-2 py-1 rounded-full shadow-lg">
                NEW
              </div>
            )}

            {video ? (
              <>
                <img
                  src={image}
                  alt={`${title} project preview`}
                  class="absolute inset-0 w-full h-full object-cover transition-all duration-400 ease-out group-hover:scale-105 video-poster"
                  loading="lazy"
                  decoding="async"
                />

                <video
                  src={video}
                  poster={image}
                  class="absolute inset-0 w-full h-full object-cover transition-all duration-400 ease-out group-hover:scale-105 opacity-0 video-element"
                  muted
                  loop
                  playsinline
                  webkit-playsinline
                  preload="metadata"
                  data-autoplay
                  onerror="this.style.display='none'; this.previousElementSibling.style.opacity='1';"
                />
              </>
            ) : (
              <img
                src={image}
                alt={`${title} project preview`}
                class="absolute inset-0 w-full h-full object-cover transition-all duration-400 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            )}



        </div>

        <div class="mt-3 sm:mt-4 lg:mt-6 flex items-center justify-between transition-all duration-300 group-hover:translate-x-1">

            <div>

                <h3 class="text-base sm:text-lg lg:text-2xl xl:text-3xl font-semibold transition-all duration-300 group-hover:text-neutral-300 text-white">
                    {title}
                </h3>

                <p class="mt-0.5 sm:mt-1 lg:mt-2 text-xs sm:text-sm lg:text-base text-neutral-500 transition-all duration-300 group-hover:text-neutral-400">
                    {category}
                </p>

            </div>

            <span class="text-xs sm:text-sm lg:text-base text-neutral-500 transition-all duration-300 group-hover:text-neutral-400">
                {year}
            </span>

        </div>

    </article>
</a>
