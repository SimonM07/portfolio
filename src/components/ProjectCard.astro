---
interface Props {
  title: string
  category: string
  year: number
  image: string
  video?: string
  slug: string
}

const { title, category, year, image, video, slug } = Astro.props
---

<a href={`/projects/${slug}`} class="group block" data-project-slug={`/projects/${slug}`}>
    <article>

        <div class="overflow-hidden rounded-3xl relative aspect-video bg-black">

            {video ? (
              <>
                <img
                  src={image}
                  alt={`${title} project preview`}
                  class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105 video-poster"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'; this.parentElement.querySelector('.video-error')?.classList.remove('hidden');"
                />

                <video
                  src={video}
                  poster={image}
                  class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105 opacity-0"
                  muted
                  autoplay
                  loop
                  playsinline
                  webkit-playsinline
                  preload="auto"
                  data-autoplay
                  onerror="this.style.display='none'; this.parentElement.querySelector('.video-poster').style.opacity = '1'; this.parentElement.querySelector('.video-error')?.classList.remove('hidden');"
                />

                <div class="video-error hidden absolute inset-0 flex items-center justify-center bg-black/80">
                  <p class="text-white text-sm">Video unavailable</p>
                </div>

                <div class="absolute inset-0 flex items-center justify-center bg-black/30 opacity-100 md:opacity-0 transition duration-300 pointer-events-none md:pointer-events-auto">
                  <div class="flex h-12 w-12 sm:h-16 sm:w-16 items-center justify-center rounded-full border border-white/40 bg-black/50 text-white shadow-lg cursor-pointer hover:bg-black/70 transition" data-play-btn>
                    <svg class="w-6 h-6 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    </svg>
                  </div>
                </div>
              </>
            ) : (
              <img
                src={image}
                alt={`${title} project preview`}
                class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            )}

            {video ? (
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 opacity-0 transition duration-300 group-hover:opacity-100 pointer-events-none">
                <div class="flex h-16 w-16 items-center justify-center rounded-full border border-white/20 bg-black/50 text-white shadow-lg">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              </div>
            ) : null}

        </div>

        <div class="mt-3 sm:mt-4 lg:mt-6 flex items-center justify-between">

            <div>

                <h3 class="text-base sm:text-lg lg:text-2xl xl:text-3xl font-semibold transition group-hover:text-neutral-300 text-white">
                    {title}
                </h3>

                <p class="mt-0.5 sm:mt-1 lg:mt-2 text-xs sm:text-sm lg:text-base text-neutral-500">
                    {category}
                </p>

            </div>

            <span class="text-xs sm:text-sm lg:text-base text-neutral-500">
                {year}
            </span>

        </div>

    </article>
</a>