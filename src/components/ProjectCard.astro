---
interface Props {
  title: string
  category: string
  year: number
  image: string
  video?: string
  slug: string
}

const { title, category, year, image, video, slug } = Astro.props
---

<a href={`/projects/${slug}`} class="group block" data-project-slug={`/projects/${slug}`}>
    <article>

        <div class="overflow-hidden rounded-3xl relative aspect-video bg-black">

            {video ? (
              <>
                <img
                  src={image}
                  alt={`${title} project preview`}
                  class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105 video-poster"
                  loading="lazy"
                  decoding="async"
                />

                <video
                  src={video}
                  poster={image}
                  class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105 opacity-0"
                  muted
                  autoplay
                  loop
                  playsinline
                  webkit-playsinline
                  preload="none"
                  data-autoplay
                  onerror="this.style.display='none'; this.previousElementSibling.style.opacity='1';"
                />
              </>
            ) : (
              <img
                src={image}
                alt={`${title} project preview`}
                class="absolute inset-0 w-full h-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            )}



        </div>

        <div class="mt-3 sm:mt-4 lg:mt-6 flex items-center justify-between">

            <div>

                <h3 class="text-base sm:text-lg lg:text-2xl xl:text-3xl font-semibold transition group-hover:text-neutral-300 text-white">
                    {title}
                </h3>

                <p class="mt-0.5 sm:mt-1 lg:mt-2 text-xs sm:text-sm lg:text-base text-neutral-500">
                    {category}
                </p>

            </div>

            <span class="text-xs sm:text-sm lg:text-base text-neutral-500">
                {year}
            </span>

        </div>

    </article>
</a>