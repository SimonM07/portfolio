---
interface Props {
  lang?: string;
}

const { lang = "sk" } = Astro.props;
---

<style>
  #mobile-menu {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: #0a0a0a;
  }

  #mobile-menu.hidden {
    transform: translateX(100%);
  }

  #mobile-menu:not(.hidden) {
    transform: translateX(0);
  }

  .menu-overlay {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    pointer-events: none;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-link {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
  }

  .nav-link:hover {
    transform: translateX(4px);
    border-color: rgba(255, 214, 10, 0.4);
    background: rgba(255, 214, 10, 0.08);
  }

  .menu-footer {
    background: rgba(0, 217, 255, 0.05);
    border-top: 1px solid rgba(0, 217, 255, 0.15);
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuOverlay = document.getElementById("menu-overlay");
    const closeButton = document.getElementById("mobile-menu-close");
    const navLinks = document.querySelectorAll("#mobile-menu a");

    if (menuButton && mobileMenu && menuOverlay) {
      menuButton.addEventListener("click", () => {
        mobileMenu.classList.remove("hidden");
        menuOverlay.classList.add("active");
        document.body.style.overflow = "hidden";
      });

      const closeMenu = () => {
        mobileMenu.classList.add("hidden");
        menuOverlay.classList.remove("active");
        document.body.style.overflow = "";
      };

      if (closeButton) {
        closeButton.addEventListener("click", closeMenu);
      }

      menuOverlay.addEventListener("click", closeMenu);

      navLinks.forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }

    // Mobile theme toggle - independent of menu initialization
    const mobileThemeBtn = document.getElementById('mobile-theme-btn');
    const mobileSunIcon = document.getElementById('mobile-sun-icon');
    const mobileMoonIcon = document.getElementById('mobile-moon-icon');

    if (mobileThemeBtn && mobileSunIcon && mobileMoonIcon) {
      // Always default to dark mode
      const storedTheme = window.localStorage.getItem('theme');
      let isDark = storedTheme ? storedTheme === 'dark' : true;

      function applyMobileTheme(darkMode: boolean) {
        document.documentElement.classList.toggle('light', !darkMode);
        mobileSunIcon?.classList.toggle('hidden', darkMode);
        mobileMoonIcon?.classList.toggle('hidden', !darkMode);
        mobileThemeBtn?.setAttribute('aria-pressed', String(!darkMode));
      }

      applyMobileTheme(isDark);

      mobileThemeBtn.addEventListener('click', () => {
        isDark = !isDark;
        applyMobileTheme(isDark);
        window.localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }
  });
</script>

<button
  id="mobile-menu-button"
  class="lg:hidden p-2 text-white hover:text-yellow-400 transition relative z-50"
  aria-label="Toggle menu"
>
  <svg
    class="w-6 h-6"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"
    ></path>
  </svg>
</button>

<!-- Overlay -->
<div
  id="menu-overlay"
  class="menu-overlay fixed inset-0 z-40 lg:hidden"
></div>

<!-- Slide-in menu -->
<div
  id="mobile-menu"
  class="hidden fixed top-0 right-0 h-full w-72 max-w-[80vw] z-[100] lg:hidden shadow-2xl border-l border-neutral-800 rounded-tl-3xl rounded-bl-3xl"
>
  <div class="flex flex-col h-full bg-neutral-950 border border-neutral-800">
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-neutral-800">
      <div>
        <span class="text-xl font-bold text-white tracking-wide">Menu</span>
        <p class="text-xs text-neutral-400 mt-1">Simon Mészáros</p>
      </div>
      <div class="flex items-center gap-3">
        <button
          id="mobile-theme-btn"
          class="w-8 h-8 rounded-full glass flex items-center justify-center hover-lift transition-all duration-300"
          aria-label="Toggle theme"
        >
          <svg id="mobile-sun-icon" class="w-4 h-4 text-yellow-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <svg id="mobile-moon-icon" class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>
        <button
          id="mobile-menu-close"
          class="p-3 text-white hover:text-yellow-400 transition rounded-xl hover:bg-neutral-700"
          aria-label="Close menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            ></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Navigation links -->
    <div class="flex-1 flex flex-col py-8 px-6 space-y-4">
      <a href={lang === "en" ? "/en#work" : "/#work"} class="nav-link text-lg font-semibold text-white py-4 px-5 rounded-xl border-l-4 border-yellow-400">
        <div class="flex items-center justify-between">
          <span>{lang === "en" ? "Work" : "Práce"}</span>
          <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <a href={lang === "en" ? "/en#about" : "/#about"} class="nav-link text-lg font-semibold text-white py-4 px-5 rounded-xl">
        <div class="flex items-center justify-between">
          <span>{lang === "en" ? "About" : "O mne"}</span>
          <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
      <a href={lang === "en" ? "/en#contact" : "/#contact"} class="nav-link text-lg font-semibold text-white py-4 px-5 rounded-xl">
        <div class="flex items-center justify-between">
          <span>{lang === "en" ? "Contact" : "Kontakt"}</span>
          <svg class="w-5 h-5 text-lime-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>
</div>