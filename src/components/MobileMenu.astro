---
interface Props {
  lang?: string;
}

const { lang = "sk" } = Astro.props;
---

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const menuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const closeButton = document.getElementById("mobile-menu-close");
    const navLinks = document.querySelectorAll("#mobile-menu a");

    if (menuButton && mobileMenu) {
      menuButton.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });

      if (closeButton) {
        closeButton.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
        });
      }

      navLinks.forEach((link) => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
        });
      });
    }
  });
</script>

<button
  id="mobile-menu-button"
  class="lg:hidden p-3 text-white hover:text-yellow-400 transition bg-black/50 rounded-lg backdrop-blur-sm"
  aria-label="Toggle menu"
>
  <svg
    class="w-8 h-8"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"
    ></path>
  </svg>
</button>

<div
  id="mobile-menu"
  class="hidden fixed inset-0 z-50 bg-black/95 backdrop-blur-sm lg:hidden"
>
  <div class="flex flex-col items-center justify-center h-full space-y-8">
    <a href={lang === "en" ? "/en#work" : "/#work"} class="text-2xl font-semibold text-white hover:text-yellow-400 transition">
      {lang === "en" ? "Work" : "Práce"}
    </a>
    <a href={lang === "en" ? "/en#about" : "/#about"} class="text-2xl font-semibold text-white hover:text-yellow-400 transition">
      {lang === "en" ? "About" : "O mne"}
    </a>
    <a href={lang === "en" ? "/en#contact" : "/#contact"} class="text-2xl font-semibold text-white hover:text-yellow-400 transition">
      {lang === "en" ? "Contact" : "Kontakt"}
    </a>
  </div>
  <button
    id="mobile-menu-close"
    class="absolute top-6 right-6 p-2 text-white hover:text-yellow-400 transition"
    aria-label="Close menu"
  >
    <svg
      class="w-8 h-8"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"
      ></path>
    </svg>
  </button>
</div>
