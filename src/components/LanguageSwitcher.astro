---
import { languages } from "../i18n/index";

interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;

// Get current path without language prefix
const pathname = Astro.url.pathname;
const isEnglishPage = pathname.startsWith('/en');
const basePath = isEnglishPage ? pathname.slice(3) : pathname; // Remove /en prefix if present
const finalPath = basePath || '/'; // Default to / if empty
---

<div class="relative" id="language-switcher">
  <button
    id="language-button"
    class="flex items-center gap-2 rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm font-medium text-white hover:bg-neutral-800 hover:border-neutral-600 hover-lift transition-all duration-300 shadow-lg shadow-yellow-400/20"
    aria-label="Select language"
  >
    <svg class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c4.97 0 9 4.03 9 9s-4.03 9-9 9-9-4.03-9-9 4.03-9 9-9zm0 0c-1.6 1.2-2.5 3-2.5 5s.9 3.8 2.5 5c1.6-1.2 2.5-3 2.5-5s-.9-3.8-2.5-5zm0 14a6.97 6.97 0 01-5-2.1m10 0A6.97 6.97 0 0112 19zm0-14a6.97 6.97 0 015 2.1m-10 0A6.97 6.97 0 0112 5z" />
    </svg>
    <span>{currentLang.toUpperCase()}</span>
  </button>

  <!-- Language dropdown -->
  <div id="language-dropdown" class="absolute right-0 mt-2 w-32 rounded-lg border border-neutral-700 bg-neutral-900 shadow-lg opacity-0 invisible transition-all duration-300 z-50">
    {Object.entries(languages).map(([code, name]) => {
      // Generate correct href based on current language and target language
      let href = '';
      if (code === 'sk') {
        // Switch to Slovak: remove /en prefix if present
        href = isEnglishPage ? finalPath : '/';
      } else {
        // Switch to English: add /en prefix if not already present
        href = isEnglishPage ? pathname : `/en${finalPath}`;
      }
      
      return (
        <a
          href={href}
          class={`block w-full px-4 py-2 text-left text-sm transition ${
            currentLang === code
              ? "bg-neutral-700 text-white"
              : "text-neutral-400 hover:text-white hover:bg-neutral-800"
          }`}
        >
          {name}
        </a>
      );
    })}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const langButton = document.getElementById('language-button');
    const langDropdown = document.getElementById('language-dropdown');
    
    if (langButton && langDropdown) {
      // Click to toggle (works on both mobile and desktop)
      langButton.addEventListener('click', (e) => {
        e.stopPropagation();
        const isVisible = langDropdown.classList.contains('opacity-100');
        if (isVisible) {
          langDropdown.classList.remove('opacity-100', 'visible');
          langDropdown.classList.add('opacity-0', 'invisible');
        } else {
          langDropdown.classList.remove('opacity-0', 'invisible');
          langDropdown.classList.add('opacity-100', 'visible');
        }
      });
      
      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (!langButton.contains(e.target as Node) && !langDropdown.contains(e.target as Node)) {
          langDropdown.classList.remove('opacity-100', 'visible');
          langDropdown.classList.add('opacity-0', 'invisible');
        }
      });
    }
  });
</script>
