---
interface Props {
  src: string;
  poster?: string;
  title?: string;
}

const { src, poster, title } = Astro.props;
---

<div class="relative rounded-2xl bg-black shadow-2xl overflow-hidden">
  <div id="video-progress" class="absolute top-0 left-0 h-1 bg-yellow-400 w-0 z-10 transition-all duration-300"></div>
  <video
    controls
    preload="metadata"
    poster={poster}
    class="w-full aspect-video object-cover object-center bg-black"
    title={title}
    playsinline
  >
    <source src={src} type="video/mp4" />
    Your browser does not support the video tag.
  </video>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.querySelector('video');
    const progressBar = document.getElementById('video-progress');
    
    if (video && progressBar) {
      video.addEventListener('progress', () => {
        if (video.buffered.length > 0) {
          const bufferedEnd = video.buffered.end(video.buffered.length - 1);
          const duration = video.duration;
          const percentage = (bufferedEnd / duration) * 100;
          progressBar.style.width = `${percentage}%`;
        }
      });

      video.addEventListener('canplaythrough', () => {
        progressBar.style.opacity = '0';
      });

      video.addEventListener('waiting', () => {
        progressBar.style.opacity = '1';
      });
    }
  });
</script>
