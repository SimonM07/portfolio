---
// Interactive background that responds to mouse movement - enhanced visibility
---

<div id="interactive-bg" class="interactive-bg"></div>

<style>
  .interactive-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.8;
    background:
      radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(255, 214, 10, 0.08) 0%,
        rgba(0, 217, 255, 0.05) 20%,
        transparent 50%),
      radial-gradient(circle at calc(100% - var(--mouse-x, 50%)) calc(100% - var(--mouse-y, 50%)),
        rgba(0, 217, 255, 0.06) 0%,
        transparent 40%);
    transition: opacity 0.3s ease;
  }
</style>

<script>
  function initInteractiveBackground() {
    const background = document.getElementById('interactive-bg');
    if (!background) return;

    let mouseX = 50;
    let mouseY = 50;
    let ticking = false;

    document.addEventListener('mousemove', (e) => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          mouseX = (e.clientX / window.innerWidth) * 100;
          mouseY = (e.clientY / window.innerHeight) * 100;
          background.style.setProperty('--mouse-x', `${mouseX}%`);
          background.style.setProperty('--mouse-y', `${mouseY}%`);
          ticking = false;
        });
        ticking = true;
      }
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractiveBackground);
  } else {
    initInteractiveBackground();
  }
</script>