---
// Interactive particle background component
---

<div id="particles-container" class="fixed inset-0 pointer-events-none z-0 overflow-hidden"></div>

<style>
  #particles-container canvas {
    position: absolute;
    top: 0;
    left: 0;
  }
</style>

<script>
  function initParticles() {
    // Disabled for performance optimization
    const particlesContainer = document.getElementById('particles-container');
    if (particlesContainer) particlesContainer.remove();
    return;
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initParticles);
  } else {
    initParticles();
  }
</script>
