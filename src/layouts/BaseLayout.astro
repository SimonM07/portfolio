---
import '../styles/global.css';
import Navbar from "../components/layout/Navbar.astro";
import InteractiveBackground from "../components/InteractiveBackground.astro";
import InteractiveParticles from "../components/InteractiveParticles.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import TouchGestures from "../components/TouchGestures.astro";

// Type declarations for GA4
declare global {
  interface Window {
    dataLayer: any[];
    gtag: (...args: any[]) => void;
  }
}

interface Props {
  title?: string;
  lang?: string;
  description?: string;
  image?: string;
}

const {
  title = "Simon's Portfolio",
  lang = 'sk',
  description = 'Simon Mészáros - Video editor and filmmaker based in Slovakia. Creating videos and editing projects.',
  image = 'https://meszaros-portfolio.netlify.app/images/projects/profile.jpg',
} = Astro.props;

const htmlLang = lang === 'en' ? 'en-US' : 'sk-SK';
const siteUrl = 'https://meszaros-portfolio.netlify.app';
const fullUrl = `${siteUrl}${Astro.url.pathname}`;
---

<!doctype html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  
  <!-- SEO Meta Tags -->
  <meta name="description" content={description} />
  <meta name="keywords" content="video editor, filmmaker, video production, editing, Premiere Pro, After Effects, Slovakia, Simon Mészáros" />
  <meta name="author" content="Simon Mészáros" />
  <meta name="robots" content="index, follow" />
 
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={fullUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'sk_SK'} />
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={fullUrl} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={image} />
  
  <!-- Canonical URL -->
  <link rel="canonical" href={fullUrl} />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LJ1PLX3TWZ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-LJ1PLX3TWZ');
  </script>

  <!-- Structured Data - Person -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Simon Mészáros",
    "jobTitle": "Video Editor",
    "description": "Professional video editor specializing in commercial, promo, and event videos",
    "image": image,
    "url": siteUrl,
    "knowsAbout": ["Video Editing", "Premiere Pro", "After Effects", "Motion Graphics", "Color Grading", "Film Production"]
  })} />

  <!-- Favicon - Circular PNG favicons -->
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
  <link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
  <link rel="icon" type="image/png" href="/favicon-64.png" sizes="64x64" />
  <link rel="icon" type="image/png" href="/favicon-128.png" sizes="128x128" />
  <link rel="icon" type="image/png" href="/favicon-256.png" sizes="256x256" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon-256.png" sizes="256x256" />


  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap"
  rel="stylesheet"
/>
</head>

<body class="bg-black text-white">

  <InteractiveBackground />
  <InteractiveParticles />

  <ThemeToggle />
  <ScrollToTop />
  <TouchGestures />
  <Navbar />

  <main>
    <slot />
  </main>

  <script src="../scripts/scroll-animations.js"></script>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }
  </script>

</body>
</html>